{
  "name": "aws-lambda-workers",
  "version": "0.1.0",
  "private": true,
  "description": "CloudFormation template: Lambda runs agent worker controller --spawn; MicroVM image runs cursor-agent worker start --pool",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bundle": "npm run bundle:handler && npm run bundle:spawn",
    "bundle:handler": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js",
    "bundle:spawn": "esbuild src/spawn.ts --bundle --platform=node --target=node22 --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/spawn.mjs",
    "validate": "./scripts/validate-template.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-ssm": "^3.893.0",
    "@aws-sdk/credential-provider-node": "^3.893.0",
    "@smithy/protocol-http": "^5.1.0",
    "@smithy/signature-v4": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
